# LIQUID (repository: Ai) — technology-neutral .gitignore
# Technology-specific rules will be added only after the stack is decided.

# --- Operating system artifacts ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- Editors and IDEs ---
.idea/
.vscode/
*.swp
*.swo
*~
.history/

# --- Environment files and local configuration ---
.env
.env.*
!.env.example

# --- Secrets and credentials (never commit) ---
*.pem
*.key
*.p12
*.pfx
secrets.*
credentials.json

# --- Logs and temporary files ---
*.log
logs/
*.tmp
*.temp
.cache/

# --- Local data dumps (supports the synthetic/anonymized data policy) ---
*.sqlite
*.sqlite3
*.dump
*.bak
